## Mandatory part ##
YELLOWSTONE_ENDPOINT=<ENDPOINT_URL>
YELLOWSTONE_X_TOKEN=<TOKEN>
WALLET_KEYPAIR=<WALLET_KEYPAIR>
COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000
MARGINFI_GROUP_KEY=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG8

# Minimum liquidation profit in USD. Unhealthy accounts below it are tagged only if the maximum
# (fully grown) liquidation premium would clear it.
MIN_PROFIT=1

SWAP_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SLIPPAGE_BPS=100
JUP_SWAP_API_URL=https://api.jup.ag/swap/v1
JUP_SWAP_API_KEY=<JUPITER_API_KEY>
TITAN_WS_ENDPOINT=us1.api.titan.exchange
TITAN_API_KEY=<TITAN_API_KEY>

## Optional part ##
# Optional override for JSON-RPC endpoint. If not set, derived as
# `${YELLOWSTONE_ENDPOINT}/${YELLOWSTONE_X_TOKEN}` (or just endpoint if token is empty).
# RPC_URL=<RPC_URL>

# Comma-separated pubkeys of address lookup tables, grouped by the bank asset tags they serve.
# ADDRESS_LOOKUP_TABLES_GROUP1=
# ADDRESS_LOOKUP_TABLES_GROUP2=
# ADDRESS_LOOKUP_TABLES_GROUP3=

# Comma-separated mints never seized, bought or sold (e.g. sunset tokens with no market).
# EXCLUDED_LIQUIDATION_MINTS=

# Backup cranking of Pyth push feeds whose sponsors stopped.
# PYTH_CRANKER_ENABLED=true
# PYTH_HERMES_URL=https://hermes.pyth.network
# PYTH_API_KEY=<PYTH_API_KEY>

# Jito bundles. Defaults: built-in block engine, 1_000_000 lamports max tip, unauthenticated.
# JITO_BLOCK_ENGINE_URL=<URL>
# JITO_TIP_MAX_LAMPORTS=1000000
# JITO_API_KEY=<UUID>

# Port to check liquidator health state via HTTP. Example: http://localhost:3000/healthz
# Defaults to 3000 if not set
PORT=3000
